# Note: 
# - Dockerfile.dev được sử dụng để chạy ứng dụng từ source code trên máy local mà không cần build JAR
# - Chỉ cần chạy docker compose up --build

# Base image: Maven + JDK 17
FROM maven:3.9.6-eclipse-temurin-17

# Cài các công cụ hệ thống cần thiết (giống Dockerfile gốc)
RUN apt-get update && \
    apt-get install -y python3 python3-pip ffmpeg ghostscript curl libreoffice && \
    apt-get clean

# Cài pdf2docx (CLI sẽ nằm ở /root/.local/bin)
RUN pip3 install --user pdf2docx

# Cài Node.js (bản 18 LTS) và sharp-cli
RUN curl -fsSL https://deb.nodesource.com/setup_18.x | bash - && \
    apt-get install -y nodejs && \
    npm install -g sharp-cli

# Thêm đường dẫn CLI của pip vào PATH
ENV PATH="/root/.local/bin:${PATH}"

# Tạo thư mục làm việc
WORKDIR /app

# Copy file cấu hình trước để cache Maven dependencies
COPY pom.xml .
COPY src ./src

# Tải sẵn các dependencies (tăng tốc cho lần build sau)
RUN mvn dependency:go-offline

# Expose port để truy cập và debug
EXPOSE 8080 5005

# Chạy ứng dụng bằng Maven từ source (hỗ trợ sửa code và hot reload)
CMD ["mvn", "spring-boot:run"]
